---
// Content migrated verbatim from the original monolithic index.html.
---
<section id="contact" class="contact-section">
    <!-- PREMIUM ENHANCEMENT: leaf watermark, right again. -->
    <div class="leaf-watermark leaf-right" data-depth="0.5" style="top:-5%; right:-10%;" aria-hidden="true">
        <picture><source srcset="/leaf.webp" type="image/webp"><img src="/leaf.png" alt="" loading="lazy"></picture>
    </div>
    <div class="contact-container">
        <div class="contact-info" data-reveal="soft-rise">
            <h2 class="contact-title">Ready to <span>Mint</span> your Brand?</h2>
            <p class="contact-subtitle" style="color: #2d523c; opacity: 0.8; font-size: 1.2rem;">
                Let’s create something that doesn't just look fresh, but stays fresh. 
                <i>Mint hai to hit hai.</i>
            </p>
            <picture><source srcset="/IMG.2.webp" type="image/webp"><img loading="lazy" decoding="async" src="/IMG.2.PNG" alt="leaf" style="width: 120px; margin-top: 40px; opacity: 0.15; transform: rotate(-15deg);"></picture>
        </div>

        <div class="contact-form-wrapper" data-reveal="soft-rise" style="--reveal-delay:150ms;">
            <form id="mintContactForm">
                <input type="text" id="userName" placeholder="What should we call you?" required>
                <input type="email" id="userEmail" placeholder="Your best email" required>
                
                <select id="userService" required>
                    <option value="" disabled selected>Which service are you looking for?</option>
                    <option value="Social Media">Social Media Management</option>
                    <option value="Photography">Photography</option>
                    <option value="Branding & Design">Branding & Identity</option>
                    <option value="Influencer Markting">Influencer Marketing</option>
                    <option value="Content Creation">Content Creation</option>
                    <option value="Web Development">Web Development</option>
                    <option value="Digital Marketing">Digital Marketing</option>
                </select>
                
                <textarea id="userVision" placeholder="Tell us about your brand vision..." rows="4"></textarea>
                
                <button type="submit" class="submit-btn">SEND INQUIRY</button>
            </form>

            <div id="success-message" style="display: none; text-align: center;">
                <h3 style="font-family: 'Fraunces', serif; color: #1e5700; font-size: 2rem;">Freshly Sent!</h3>
                <p style="color: #2d523c;">Your vision has reached our lab. Stay tuned.</p>
            </div>
        </div>
    </div>
</section>

