---
// Content migrated verbatim from the original monolithic index.html.
---
<section id="process" class="how-we-mint">
    <!-- PREMIUM ENHANCEMENT: large faint leaf watermark, drifts slowly and
         shifts a few px with the cursor via data-depth. Purely decorative. -->
    <div class="leaf-watermark" data-depth="0.6" style="top:6%; left:-9%;" aria-hidden="true">
        <picture><source srcset="/leaf.webp" type="image/webp"><img src="/leaf.png" alt="" loading="lazy"></picture>
    </div>
    <div class="hwm-intro" data-aos="fade-up">
        <div class="section-tag">
            <picture><source srcset="/IMG.2.webp" type="image/webp"><img loading="lazy" decoding="async" src="/IMG.2.PNG" alt="leaf"></picture> OUR PROCESS
        </div>
        <h2 class="hwm-headline">How We Mint</h2>
        <p class="hwm-sub">A proven process that combines strategy, creativity, and consistency to grow your brand and build a powerful online presence.</p>
        <svg class="hwm-divider" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18 2C18 2 8 10 8 20c0 5.52 4.48 10 10 10s10-4.48 10-10C28 10 18 2 18 2z" fill="#2d523c" opacity="0.6"/>
            <path d="M18 8l-2 8h4l-2-8z" fill="#f8f4e9" opacity="0.8"/>
        </svg>
    </div>

    <picture><source srcset="/IMG.2.webp" type="image/webp"><img loading="lazy" decoding="async" src="/IMG.2.PNG" alt="" class="hwm-leaf-decor hwm-leaf-tl"></picture>
    <picture><source srcset="/IMG.2.webp" type="image/webp"><img loading="lazy" decoding="async" src="/IMG.2.PNG" alt="" class="hwm-leaf-decor hwm-leaf-br"></picture>

    <div class="hwm-wave-wrap">
        <svg class="hwm-wave-svg" viewBox="0 0 1240 420" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path class="hwm-wave-path" d="M 20 60 C 90 55, 130 90, 155 90 S 260 150, 300 200 S 400 260, 450 260 S 560 130, 620 120 S 730 95, 790 95 S 900 250, 960 260 S 1080 300, 1150 300 S 1195 305, 1215 310"/>
            <circle class="hwm-wave-dot" cx="155" cy="90" r="4"/>
            <circle class="hwm-wave-dot" cx="450" cy="260" r="4"/>
            <circle class="hwm-wave-dot" cx="620" cy="120" r="4"/>
            <circle class="hwm-wave-dot" cx="960" cy="260" r="4"/>
            <path d="M 1200 302 l 15 8 l -6 15" fill="none" stroke="var(--dark-green)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"/>
        </svg>

        <div class="hwm-steps">
            <!-- Step 01 -->
            <div class="hwm-step" data-aos="fade-up" data-aos-delay="0">
                <div class="hwm-step-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                </div>
                <div class="hwm-step-heading">
                    <span class="hwm-step-num">01</span>
                    <h3 class="hwm-step-title">Discover</h3>
                </div>
                <p class="hwm-step-desc">We learn about your brand, goals, and audience to build a strong foundation.</p>
            </div>

            <!-- Step 02 -->
            <div class="hwm-step" data-aos="fade-up" data-aos-delay="100">
                <div class="hwm-step-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 4h6a1 1 0 011 1v1H8V5a1 1 0 011-1z"/>
                        <rect x="5" y="5" width="14" height="16" rx="2"/>
                        <path d="M9 13l2 2 4-5"/>
                    </svg>
                </div>
                <div class="hwm-step-heading">
                    <span class="hwm-step-num">02</span>
                    <h3 class="hwm-step-title">Strategize</h3>
                </div>
                <p class="hwm-step-desc">We create a customized strategy tailored to your brand and designed for real impact.</p>
            </div>

            <!-- Step 03 -->
            <div class="hwm-step" data-aos="fade-up" data-aos-delay="200">
                <div class="hwm-step-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 3a2.85 2.85 0 114 4L7.5 20.5 2 22l1.5-5.5z"/>
                    </svg>
                </div>
                <div class="hwm-step-heading">
                    <span class="hwm-step-num">03</span>
                    <h3 class="hwm-step-title">Create &amp; Connect</h3>
                </div>
                <p class="hwm-step-desc">We craft engaging content and manage your channels to connect with the right audience.</p>
            </div>

            <!-- Step 04 -->
            <div class="hwm-step" data-aos="fade-up" data-aos-delay="300">
                <div class="hwm-step-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 3v18h18"/><path d="M7 15l4-4 3 3 5-6"/><path d="M16 8h3v3"/>
                    </svg>
                </div>
                <div class="hwm-step-heading">
                    <span class="hwm-step-num">04</span>
                    <h3 class="hwm-step-title">Analyze &amp; Grow</h3>
                </div>
                <p class="hwm-step-desc">We track performance, measure results, and optimize to keep your brand growing.</p>
            </div>
        </div>
    </div>

</section>

