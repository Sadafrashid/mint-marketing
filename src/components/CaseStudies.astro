---
// Content migrated verbatim from the original monolithic index.html.
---
    <section id="case-studies" class="cs-section">

        <div class="cs-leaf-bg" id="csLeafBg" aria-hidden="true">
            <img src="/leaf.png" alt="" loading="lazy">
        </div>

        <div class="cs-head">
            <span class="cs-label" data-reveal="soft-rise">Case Studies</span>
            <h2 class="cs-heading" data-reveal="soft-rise" style="--reveal-delay:80ms;">Crafting Brands That<br>Drive Growth</h2>
            <p class="cs-sub" data-reveal="soft-rise" style="--reveal-delay:160ms;">A closer look at the strategy, craft and results behind the brands we've built — browse the work below.</p>
        </div>

        <div class="cs-layout">
            <div class="cs-carousel" id="csCarousel" data-reveal="soft-rise" style="--reveal-delay:220ms;">
                <div class="cs-stage" id="csStage" role="listbox" aria-label="Case studies" aria-roledescription="carousel">
                    <!-- .cs-slot elements are rendered by the script below, one per entry in CASE_STUDIES. -->
                </div>

                <button class="cs-arrow cs-arrow-prev" id="csPrev" aria-label="Previous case study">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <button class="cs-arrow cs-arrow-next" id="csNext" aria-label="Next case study">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 18l6-6-6-6"/></svg>
                </button>

                <div class="cs-progress" aria-hidden="true">
                    <div class="cs-progress-fill" id="csProgressFill"></div>
                </div>
            </div>

            <div class="cs-details" id="csDetails">
                <div class="cs-details-row">
                    <div class="cs-details-copy">
                        <span class="cs-details-eyebrow" id="csEyebrow">Fitness &middot; Branding &middot; Social Media</span>
                        <h3 class="cs-details-name" id="csName">Ultra Pro Gym</h3>
                        <p class="cs-details-desc" id="csDesc">A complete digital transformation that took a quiet local gym and turned it into the loudest fitness brand in the market.</p>
                    </div>
                    <a href="#contact" class="cs-cta" id="csCta">
                        <span>View Full Case Study</span>
                        <span class="cs-cta-arrow" aria-hidden="true">&rarr;</span>
                    </a>
                </div>

                <div class="cs-metrics" id="csMetrics"><!-- rendered by script --></div>
            </div>
        </div>

    </section>

