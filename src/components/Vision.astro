---
// Content migrated verbatim from the original monolithic index.html.
---
    <section id="vision" class="vision-stats-section" data-reveal="leaf-grow">
    <picture><source srcset="/IMG.2.webp" type="image/webp"><img src="/IMG.2.PNG" class="reveal-leaf" alt="" aria-hidden="true" loading="lazy" decoding="async" style="width:32px; display:block; margin:0 auto 14px; filter:brightness(0) invert(1);"></picture>
    <div class="vision-stats-grid reveal-body" data-reveal="leaf-grow">
        
        <!-- Stat Item 1 -->
        <div class="v-stat-item">
            <b class="stat-count" data-target="10000" data-suffix="+">0+</b>
            <span>Content Pieces Produced</span>
        </div>


        <!-- Stat Item 2 -->
        <div class="v-stat-item">
            <b class="stat-count" data-target="350" data-suffix="+">0+</b>
            <span>Brands Worked With</span>
        </div>

        <!-- Stat Item 3 -->
        <div class="v-stat-item">
            <b class="stat-count" data-target="55" data-suffix="+">0+</b>
            <span>Team Size</span>
        </div>

        <!-- Stat Item 4 -->
        <div class="v-stat-item">
            <b class="stat-count" data-target="20" data-suffix="+">0+</b>
            <span>Industries Served</span>
        </div>

    </div>
</section>



