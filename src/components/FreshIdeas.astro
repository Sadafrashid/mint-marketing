---
// Content migrated verbatim from the original monolithic index.html.
---
    <section class="fi-workspace" id="freshIdeas">
      <div class="fi-inner">

        <div>
          <div class="fi-eyebrow">Fresh Ideas</div>
          <h2 class="fi-headline">Design that <em>moves people.</em></h2>
          <p class="fi-copy">Every brand we touch starts on paper like this — sketches, swatches, and mockups scattered across the studio table before they ever become a strategy.</p>
        
          <div class="fi-quote"><span class="fi-dot"></span>"Creativity is intelligence having fun." — Albert Einstein</div>
        </div>

        <div class="fi-scene-viewport" id="fiSceneViewport">
        <div class="fi-scene-holder" id="fiSceneHolder">
          <div class="fi-scene" id="fiScene">

            <div class="fi-float" style="left:12px; top:12px;" data-fi-depth="26">
              <div class="fi-float-inner" style="--fi-rot:4deg; animation-delay:-3s;">
                <div class="fi-card fi-mag">
                  <h4>Pure<br>Mint</h4>
                  <p>Skincare</p>
                </div>
              </div>
            </div>

            <div class="fi-float" style="left:372px; top:0px;" data-fi-depth="34">
              <div class="fi-float-inner" style="--fi-rot:-5deg; animation-delay:-0.6s;">
                <div class="fi-card fi-product">
                  <h5>A New<br>Standard<br>of Care</h5>
                  <div class="fi-bottle"></div>
                </div>
              </div>
            </div>
            
            <!-- signature element -->
            <div class="fi-float" style="left:99px; top:120px;" data-fi-depth="10">
              <div class="fi-float-inner" style="--fi-rot:0deg; animation-delay:-1.2s;">
                <div class="fi-sketchbook">
                  <div class="fi-clip"></div>
                  <div class="fi-sketchbook-inner">
                    <div class="fi-sb-page left">
                      <h3>Ideas That<br>Build Brands</h3>
                      <div class="fi-sb-lines"><span></span><span></span></div>
                    </div>
                    <div class="fi-sb-page">
                      <div class="fi-sb-grid">
                        <div style="background:#c9c2ac;"></div>
                        <div style="background: var(--accent-green);"></div>
                        <div style="background:#e8e1d0;"></div>
                        <div style="background: var(--gold-light);"></div>
                        <div style="background: var(--deep);"></div>
                        <div style="background:#d7cdb5;"></div>
                      </div>
                      <div class="fi-sb-lines" style="margin-top:10px;"><span></span><span style="width:50%;"></span></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="fi-float" style="left:409px; top:204px;" data-fi-depth="40">
              <div class="fi-float-inner" style="--fi-rot:6deg; animation-delay:-2s;">
                <div class="fi-phone" id="fiPhone" role="button" tabindex="0" aria-pressed="false" aria-label="Toggle phone screen on or off">
                  <div class="fi-phone-screen">
                    <div class="fi-phone-notch"></div>
                    <div class="fi-phone-ui">
                      <div class="fi-phone-head"><div class="fi-avatar"></div><span>mint.marketing</span></div>
                      <div class="fi-phone-grid">
                        <div style="background: var(--deep)"></div><div style="background:#c9c2ac"></div><div style="background: var(--gold-light)"></div>
                        <div style="background:#e8e1d0"></div><div style="background: var(--accent-green)"></div><div style="background:#d7cdb5"></div>
                        <div style="background:#10190f"></div><div style="background:#b5ac93"></div><div style="background: var(--deep)"></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <div class="fi-float" style="left:37px; top:396px;" data-fi-depth="30">
              <div class="fi-float-inner" style="--fi-rot:-3deg; animation-delay:-3.4s;">
                <div class="fi-bizcard"><strong>MINT</strong><span>Mint Marketing</span></div>
              </div>
            </div>

            <div class="fi-float" style="left:322px; top:420px;" data-fi-depth="20">
              <div class="fi-float-inner" style="--fi-rot:5deg; animation-delay:-1.8s;">
                <div class="fi-card fi-pantone">
                  <p class="label">Pantone®</p>
                  <div class="fi-swatch"></div>
                  <p>Mint Green</p>
                  <p class="code">15-6320 TCX</p>
                </div>
              </div>
            </div>

          </div>
        </div>
        </div>

      </div>
    </section>

