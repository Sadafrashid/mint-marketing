---
import Layout from '../layouts/Layout.astro';

import Hero from '../components/Hero.astro';
import HeroScripts from '../components/HeroScripts.astro';

import FreshIdeas from '../components/FreshIdeas.astro';
import FreshIdeasScripts from '../components/FreshIdeasScripts.astro';

import Vision from '../components/Vision.astro';
import Brands from '../components/Brands.astro';

import InstagramReels from '../components/InstagramReels.astro';
import InstagramScripts from '../components/InstagramScripts.astro';

import Process from '../components/Process.astro';
import Testimonials from '../components/Testimonials.astro';

import Services from '../components/Services.astro';
import ServicesScripts from '../components/ServicesScripts.astro';

import CaseStudies from '../components/CaseStudies.astro';
import CaseStudiesScripts from '../components/CaseStudiesScripts.astro';

import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Modals from '../components/Modals.astro';

import GlobalScripts from '../components/GlobalScripts.astro';
---
<Layout>
  <!-- Intro / hero screen: loader, nav, particle + 3D canvas, headline -->
  <Hero />
  <HeroScripts />

  <!-- Main site: same #main-site wrapper and section order as the original file -->
  <div id="main-site">

    <FreshIdeas />
    <FreshIdeasScripts />

    <Vision />
    <Brands />

    <InstagramReels />
    <InstagramScripts />

    <Process />
    <Testimonials />

    <Services />
    <ServicesScripts />

    <CaseStudies />
    <CaseStudiesScripts />

    <FAQ />
    <Contact />
    <Footer />
    <Modals />

  </div><!-- /#main-site -->

  <GlobalScripts />
</Layout>
